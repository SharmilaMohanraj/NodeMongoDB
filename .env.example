PORT=8000
# The compose Mongo is a single-node rs0 replica set. directConnection is required
# from the host because the replica member advertises its Docker DNS name, mongo.
MONGODB_URI=mongodb://127.0.0.1:27017/hrdb?replicaSet=rs0&directConnection=true
MONGODB_DB=hrdb
JWT_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=info
